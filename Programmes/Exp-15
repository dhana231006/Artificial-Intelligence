# Decision Tree Implementation for AI Lab

def decision_tree(age, study_hours):
    if study_hours >= 6:
        return "Pass"
    else:
        return "Fail"


# Training examples
print("Decision Tree Classification")
print("----------------------------")

students = [
    (18, 2),
    (19, 3),
    (20, 5),
    (21, 6),
    (22, 7),
    (23, 8)
]

for age, hours in students:
    result = decision_tree(age, hours)
    print("Age =", age, "Study Hours =", hours, "Result =", result)


# Test data
age = 21
study_hours = 6

result = decision_tree(age, study_hours)

print("\nTest Data")
print("Age =", age)
print("Study Hours =", study_hours)
print("Prediction =", result)

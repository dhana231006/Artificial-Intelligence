N = 8

board = [[0]*N for i in range(N)]

def safe(row, col):

    for i in range(col):
        if board[row][i] == 1:
            return False

    i = row
    j = col
    while i >= 0 and j >= 0:
        if board[i][j] == 1:
            return False
        i -= 1
        j -= 1

    i = row
    j = col
    while i < N and j >= 0:
        if board[i][j] == 1:
            return False
        i += 1
        j -= 1

    return True

def solve(col):

    if col == N:
        return True

    for i in range(N):
        if safe(i, col):
            board[i][col] = 1

            if solve(col+1):
                return True

            board[i][col] = 0

    return False

solve(0)

for row in board:
    print(row)
